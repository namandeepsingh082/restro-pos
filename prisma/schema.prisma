// ---------------------------------------------------------------------------
// Restro POS — data model
//
// PORTABILITY RULES (SQLite now, PostgreSQL later):
//  1. No Prisma `enum` blocks — SQLite does not support them. Status/type
//     columns are `String` and validated in code via src/lib/constants.ts.
//  2. No `Decimal` / `Float` for money. EVERY money column is an `Int` in the
//     currency's minor unit (paise for INR, cents for USD). This removes
//     floating point drift and behaves identically on both engines.
//  3. No native database arrays and no `Json` column type — small structured
//     payloads (add-ons, audit metadata) are stored as JSON *strings*.
//  4. Only `@default(now())`, `@updatedAt` and `cuid()` defaults are used, all
//     of which are generated by Prisma rather than the database.
//
// To migrate to PostgreSQL: change `provider` below to "postgresql", point
// DATABASE_URL at the server, then `npx prisma migrate deploy`. No column
// types need to change.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // change to "postgresql" for production
  url      = env("DATABASE_URL")
}

// --------------------------- Users & access --------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  passwordHash String
  roleId       String
  role         Role     @relation(fields: [roleId], references: [id])
  /// Hard ceiling on the discount a cashier may apply without admin approval.
  /// Percent value 0-100. Admins ignore this.
  maxDiscountPct Int    @default(0)
  /// Ceiling in minor units for fixed-amount discounts. 0 = not allowed.
  maxDiscountAmt Int    @default(0)
  active       Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders          Order[]           @relation("OrderCashier")
  discountsGiven  OrderDiscount[]
  auditLogs       AuditLog[]
  refunds         Refund[]
  cashSessions    CashRegisterSession[]
  cashTxns        CashTransaction[]

  @@index([roleId])
}

model Role {
  id          String  @id @default(cuid())
  /// "ADMIN" | "CASHIER" — see src/lib/constants.ts
  key         String  @unique
  name        String
  /// JSON string array of permission keys, e.g. ["order.create","menu.write"]
  permissions String  @default("[]")
  users       User[]
}

// --------------------------- Restaurant config -----------------------------

model RestaurantSettings {
  /// Single row, always id = 1.
  id                  Int      @id @default(1)
  name                String   @default("My Restaurant")
  logoDataUrl         String?  // small base64 PNG, printed on the receipt
  addressLine1        String   @default("")
  addressLine2        String   @default("")
  city                String   @default("")
  phone               String   @default("")
  email               String   @default("")
  gstNumber           String   @default("")
  fssaiNumber         String   @default("")
  receiptFooter       String   @default("Thank you. Visit again!")
  currency            String   @default("INR")
  locale              String   @default("en-IN")
  timeZone            String   @default("Asia/Kolkata")
  /// 58 or 80 (mm)
  receiptWidth        Int      @default(80)
  /// Percent, applied to items that have no explicit tax percent.
  defaultTaxPct       Int      @default(5)
  /// Show a single "Tax" line vs CGST/SGST split halves.
  splitTaxOnReceipt   Boolean  @default(true)
  defaultPackagingChg Int      @default(0)
  defaultDeliveryChg  Int      @default(0)
  /// Round the grand total to the nearest whole currency unit and print the
  /// difference as "Round off".
  roundOffTotals      Boolean  @default(true)
  billNumberFormat    String   @default("INV-{YY}{MM}{DD}-{SEQ:4}")
  orderNumberFormat   String   @default("{SEQ:5}")
  kotNumberFormat     String   @default("K-{SEQ:4}")
  printKotOnSave      Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

/// Atomic sequence generator for bill / order / KOT numbers.
model Counter {
  /// "bill" | "order" | "kot", suffixed with the reset scope, e.g. "bill:20260730"
  key       String   @id
  value     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Tax {
  id        String  @id @default(cuid())
  name      String  // e.g. "GST 5%"
  percent   Int     // whole percent
  isDefault Boolean @default(false)
  active    Boolean @default(true)
  menuItems MenuItem[]
}

// --------------------------- Menu ------------------------------------------

model MenuCategory {
  id        String     @id @default(cuid())
  name      String     @unique
  sortOrder Int        @default(0)
  active    Boolean    @default(true)
  /// Default kitchen routing for items in this category ("Kitchen", "Tandoor",
  /// "Bar", "Dessert") — printed on the KOT header.
  prepArea  String?
  items     MenuItem[]
}

model MenuItem {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String  @default("")
  categoryId  String
  category    MenuCategory @relation(fields: [categoryId], references: [id])
  /// Base price in minor units. Ignored when the item has variants.
  price       Int
  taxId       String?
  tax         Tax?    @relation(fields: [taxId], references: [id])
  /// Overrides tax/defaultTaxPct when not null.
  taxPct      Int?
  /// true = vegetarian (green mark), false = non-vegetarian (red mark)
  isVeg       Boolean @default(true)
  /// Out of stock right now — hidden from billing, kept in reports.
  available   Boolean @default(true)
  /// Soft-disabled by admin (seasonal item etc.) — hidden everywhere.
  enabled     Boolean @default(true)
  prepArea    String?
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants   MenuItemVariant[]
  addOns     MenuItemAddOn[]
  orderItems OrderItem[]

  @@index([categoryId])
  @@index([name])
}

model MenuItemVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // Half / Full / Small / Medium / Large
  price      Int
  sortOrder  Int      @default(0)
  active     Boolean  @default(true)
  orderItems OrderItem[]

  @@unique([menuItemId, name])
}

model MenuItemAddOn {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String   // Extra cheese / Extra butter / Jain
  price      Int      @default(0)
  active     Boolean  @default(true)

  @@unique([menuItemId, name])
}

// --------------------------- Customers -------------------------------------

model Customer {
  id           String   @id @default(cuid())
  name         String
  phone        String   @unique
  addressLine  String   @default("")
  landmark     String   @default("")
  totalOrders  Int      @default(0)
  totalSpend   Int      @default(0)
  lastOrderAt  DateTime?
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

// --------------------------- Orders ----------------------------------------

model Order {
  id         String   @id @default(cuid())
  orderNo    String   @unique
  billNo     String?  @unique // assigned when the bill is generated
  /// "DINEIN" | "TAKEAWAY" | "DELIVERY"
  orderType  String
  /// "DRAFT" | "HELD" | "NEW" | "PREPARING" | "READY" | "DELIVERED" |
  /// "COMPLETED" | "CANCELLED" | "REFUNDED"
  status     String   @default("NEW")
  /// "UNPAID" | "PARTIAL" | "PAID"
  paymentStatus String @default("UNPAID")

  tableNo       String?
  customerName  String?
  customerPhone String?
  address       String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  /// Notes for the kitchen; printed on the KOT.
  instructions  String    @default("")

  // ---- money, all in minor units, all recomputed server-side ----
  itemsSubtotal   Int @default(0) // sum of line totals before discount
  itemDiscount    Int @default(0) // sum of line-level discounts
  orderDiscount   Int @default(0) // whole-order discount
  discountTotal   Int @default(0) // itemDiscount + orderDiscount
  taxableAmount   Int @default(0)
  taxTotal        Int @default(0)
  packagingCharge Int @default(0)
  deliveryCharge  Int @default(0)
  roundOff        Int @default(0)
  grandTotal      Int @default(0)
  paidTotal       Int @default(0)
  refundedTotal   Int @default(0)

  cashierId String
  cashier   User   @relation("OrderCashier", fields: [cashierId], references: [id])

  /// Client-generated UUID. Unique, so a double-tapped "Save & print" or a
  /// replayed offline order can never create two orders.
  idempotencyKey String? @unique
  /// Set for orders created while offline and synced later.
  offlineCreatedAt DateTime?
  kotBatches   Int      @default(0) // how many KOTs have been printed
  billPrints   Int      @default(0)
  cancelReason String?
  reopenedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  completedAt  DateTime?
  /// When an admin bills a meal for an earlier time — the customer ate at lunch
  /// and asks for the bill at night — `createdAt` carries the time the customer
  /// is billed for and this carries the real wall-clock moment the row was
  /// written. Null on an ordinary bill. Never printed on the slip; it exists so
  /// that "which day did this money actually arrive" stays answerable.
  actualCreatedAt DateTime?

  items     OrderItem[]
  payments  Payment[]
  discounts OrderDiscount[]
  refunds   Refund[]

  @@index([createdAt])
  @@index([status])
  @@index([orderType])
  @@index([cashierId])
  @@index([customerPhone])
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id])
  variantId  String?
  variant    MenuItemVariant? @relation(fields: [variantId], references: [id])

  /// Snapshots — a later price or name change must not rewrite history.
  nameSnapshot    String
  variantSnapshot String?
  isVeg           Boolean @default(true)
  prepArea        String?

  unitPrice    Int
  qty          Int
  /// JSON string: [{ "name": "Extra cheese", "price": 2000 }]
  addOnsJson   String @default("[]")
  addOnTotal   Int    @default(0)
  discount     Int    @default(0) // line-level discount, minor units
  taxPct       Int    @default(0)
  taxAmount    Int    @default(0)
  lineSubtotal Int    @default(0) // (unitPrice + addOnTotal) * qty
  lineTotal    Int    @default(0) // lineSubtotal - discount + taxAmount
  instructions String @default("")
  isComplimentary Boolean @default(false)
  /// Which KOT batch this line was printed on. 0 = not yet printed, so
  /// "print new items only" is just `where kotBatch = 0`.
  kotBatch     Int    @default(0)
  voided       Boolean @default(false)

  @@index([orderId])
  @@index([menuItemId])
}

model Payment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// "CASH" | "UPI" | "CARD" | "ONLINE" | "OTHER"
  method    String
  amount    Int
  /// Last 4 of a card, UPI ref, aggregator name. Never a full card number.
  reference String?
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Discount {
  id          String  @id @default(cuid())
  name        String
  /// "PERCENT" | "FIXED" | "COUPON" | "COMPLIMENTARY"
  kind        String
  /// Percent when kind = PERCENT, else minor units.
  value       Int
  code        String? @unique
  minOrder    Int     @default(0)
  maxDiscount Int     @default(0) // 0 = uncapped
  active      Boolean @default(true)
  requiresAdmin Boolean @default(false)
  validFrom   DateTime?
  validTo     DateTime?
  applications OrderDiscount[]
}

/// A discount actually applied to an order (or one of its lines).
model OrderDiscount {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId String?
  discountId  String?
  discount    Discount? @relation(fields: [discountId], references: [id])
  kind        String
  value       Int
  amount      Int // resolved amount in minor units
  code        String?
  reason      String  @default("")
  appliedById String
  appliedBy   User    @relation(fields: [appliedById], references: [id])
  approvedBy  String?
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount    Int
  /// "FULL" | "PARTIAL"
  kind      String
  method    String
  reason    String
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([createdAt])
}

// --------------------------- Cash register ---------------------------------

model CashRegisterSession {
  id          String   @id @default(cuid())
  openedById  String
  openedBy    User     @relation(fields: [openedById], references: [id])
  openingCash Int
  closingCash Int?
  /// Snapshot of the expected figure at close time.
  expectedCash Int?
  difference   Int?
  note         String   @default("")
  openedAt     DateTime @default(now())
  closedAt     DateTime?
  transactions CashTransaction[]

  @@index([openedAt])
}

model CashTransaction {
  id        String   @id @default(cuid())
  sessionId String
  session   CashRegisterSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// "ADD" | "EXPENSE"
  kind      String
  amount    Int
  note      String   @default("")
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])
  createdAt DateTime @default(now())

  @@index([sessionId])
}

// --------------------------- Audit -----------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  actorName String   @default("system")
  /// "order.create" | "order.cancel" | "order.refund" | "menu.update" | ...
  action    String
  entity    String
  entityId  String?
  /// JSON string with the before/after or the relevant payload.
  metaJson  String   @default("{}")
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@index([entity, entityId])
}
