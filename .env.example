# ---------------------------------------------------------------------------
# Database. SQLite for local dev; swap for PostgreSQL in production.
#   SQLite     : file:./dev.db
#   PostgreSQL : postgresql://user:pass@localhost:5432/restropos?schema=public
# When you switch, also change `provider` in prisma/schema.prisma.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Session signing secret. MUST be changed. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-please-use-a-long-random-string"

# Session lifetime in hours
SESSION_HOURS=12

# Seed credentials (used only by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@restaurant.local"
SEED_ADMIN_PASSWORD="admin@123"
SEED_CASHIER_EMAIL="cashier@restaurant.local"
SEED_CASHIER_PASSWORD="cashier@123"
